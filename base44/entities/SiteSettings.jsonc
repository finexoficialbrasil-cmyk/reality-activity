{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "ceo_video_url": {
      "type": "string",
      "description": "URL do v\u00eddeo do CEO (YouTube: https://youtu.be/... ou https://youtube.com/watch?v=...)"
    },
    "ceo_video_title": {
      "type": "string",
      "default": "Mensagem do CEO",
      "description": "T\u00edtulo exibido acima do v\u00eddeo"
    },
    "ceo_video_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o exibida abaixo do v\u00eddeo"
    },
    "ceo_video_active": {
      "type": "boolean",
      "default": true,
      "description": "V\u00eddeo do CEO ativo na p\u00e1gina Holding"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}