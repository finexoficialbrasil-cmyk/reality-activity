{
  "name": "Category",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "value": {
      "type": "string",
      "description": "Identificador \u00fanico (slug, ex: airbnb)"
    },
    "label": {
      "type": "string",
      "description": "Nome exibido (ex: Airbnb)"
    },
    "icon": {
      "type": "string",
      "description": "Emoji do \u00edcone (ex: \ud83c\udfe0)"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Categoria ativa"
    }
  },
  "required": [
    "value",
    "label"
  ]
}