{
  "name": "Advertisement",
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do an\u00fancio"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do an\u00fancio"
    },
    "type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image",
      "description": "Tipo de an\u00fancio: imagem ou v\u00eddeo"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem do an\u00fancio"
    },
    "video_url": {
      "type": "string",
      "description": "Link do v\u00eddeo YouTube (https://youtu.be/... ou https://youtube.com/watch?v=...)"
    },
    "link": {
      "type": "string",
      "description": "Link do an\u00fancio (Mercado Livre, Shopee, etc)"
    },
    "category": {
      "type": "string",
      "enum": [
        "mercado_livre",
        "shopee",
        "tiktok_shop",
        "amazon",
        "produtos_digitais",
        "servicos",
        "outros"
      ],
      "description": "Categoria do an\u00fancio"
    },
    "budget_total": {
      "type": "number",
      "default": 100,
      "description": "Or\u00e7amento total em pontos para este an\u00fancio"
    },
    "budget_remaining": {
      "type": "number",
      "default": 100,
      "description": "Saldo restante dispon\u00edvel para pagamentos"
    },
    "reward_per_share": {
      "type": "number",
      "default": 10,
      "description": "Pontos pagos por cada compartilhamento"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que criou o an\u00fancio"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que criou o an\u00fancio"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "inactive"
      ],
      "default": "pending",
      "description": "Status de aprova\u00e7\u00e3o"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Motivo da rejei\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "An\u00fancio ativo"
    },
    "shares_count": {
      "type": "number",
      "default": 0,
      "description": "Total de compartilhamentos"
    },
    "total_points_awarded": {
      "type": "number",
      "default": 0,
      "description": "Total de pontos distribu\u00eddos por compartilhamentos"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "cooldown_until": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora at\u00e9 quando o an\u00fancio est\u00e1 em cooldown de 24h ap\u00f3s or\u00e7amento zerado"
    }
  },
  "required": [
    "title",
    "link",
    "category",
    "budget_total",
    "reward_per_share"
  ]
}