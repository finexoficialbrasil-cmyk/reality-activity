{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "description": "Identificador \u00fanico da opera\u00e7\u00e3o (UUID)"
    },
    "admin_email": {
      "type": "string",
      "description": "Email do administrador respons\u00e1vel"
    },
    "admin_name": {
      "type": "string",
      "description": "Nome do administrador respons\u00e1vel"
    },
    "action": {
      "type": "string",
      "description": "A\u00e7\u00e3o executada (ex: withdrawal_approve, withdrawal_reject, user_block, user_unblock, financial_settings_update, balance_adjust, purchase_approve, purchase_reject)"
    },
    "target_type": {
      "type": "string",
      "description": "Tipo de registro afetado (ex: WithdrawalRequest, User, PurchaseSettings, UserPoints, PointsPurchase)"
    },
    "target_id": {
      "type": "string",
      "description": "ID do registro afetado"
    },
    "target_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio afetado (quando aplic\u00e1vel)"
    },
    "value_before": {
      "type": "string",
      "description": "Estado/valor anterior (JSON serializado)"
    },
    "value_after": {
      "type": "string",
      "description": "Estado/valor posterior (JSON serializado)"
    },
    "reason": {
      "type": "string",
      "description": "Motivo informado para a a\u00e7\u00e3o (quando houver)"
    },
    "request_id": {
      "type": "string",
      "description": "Identificador de idempot\u00eancia da requisi\u00e7\u00e3o"
    },
    "ip": {
      "type": "string",
      "description": "IP de origem do admin"
    },
    "metadata": {
      "type": "object",
      "description": "Dados adicionais espec\u00edficos da a\u00e7\u00e3o",
      "properties": {}
    }
  },
  "required": [
    "admin_email",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}