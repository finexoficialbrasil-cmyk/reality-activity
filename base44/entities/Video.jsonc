{
  "name": "Video",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do v\u00eddeo / banner"
    },
    "type": {
      "type": "string",
      "enum": [
        "mp4",
        "youtube",
        "banner"
      ],
      "default": "mp4",
      "description": "Tipo de conte\u00fado"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "video_url": {
      "type": "string",
      "description": "URL do v\u00eddeo mp4 ou link YouTube (https://youtu.be/... ou https://youtube.com/watch?v=...)"
    },
    "banner_url": {
      "type": "string",
      "description": "URL da imagem do banner (imgur, etc)"
    },
    "banner_link": {
      "type": "string",
      "description": "URL de destino ao clicar no banner"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail do v\u00eddeo"
    },
    "description": {
      "type": "string"
    },
    "points_per_second": {
      "type": "number",
      "default": 1,
      "description": "Pontos por segundo assistido / visualizado"
    },
    "bonus_points": {
      "type": "number",
      "default": 50,
      "description": "B\u00f4nus ao completar"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em segundos"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "total_points_awarded": {
      "type": "number",
      "default": 0
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "company_id"
  ]
}