{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do v\u00eddeo"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "video_url": {
      "type": "string",
      "description": "URL do v\u00eddeo (mp4 ou embed)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail do v\u00eddeo"
    },
    "description": {
      "type": "string"
    },
    "points_per_second": {
      "type": "number",
      "default": 1,
      "description": "Pontos por segundo assistido"
    },
    "bonus_points": {
      "type": "number",
      "default": 50,
      "description": "B\u00f4nus ao completar"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em segundos"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "total_points_awarded": {
      "type": "number",
      "default": 0
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "company_id",
    "video_url"
  ]
}