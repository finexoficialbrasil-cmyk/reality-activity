{
  "name": "PointsTransfer",
  "type": "object",
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "properties": {
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "receiver_email": {
      "type": "string"
    },
    "receiver_name": {
      "type": "string"
    },
    "points_amount": {
      "type": "number"
    },
    "transaction_value": {
      "type": "number",
      "default": 0
    },
    "note": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "marketplace"
      ],
      "default": "direct"
    },
    "listing_id": {
      "type": "string"
    }
  },
  "required": [
    "sender_email",
    "receiver_email",
    "points_amount"
  ]
}