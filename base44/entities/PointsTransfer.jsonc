{
  "name": "PointsTransfer",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.receiver_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "transfer_id": {
      "type": "string",
      "description": "ID \u00fanico da transfer\u00eancia (formato: TRF-XXXXXXXX)"
    },
    "sender_email": {
      "type": "string",
      "description": "Email do remetente"
    },
    "sender_name": {
      "type": "string",
      "description": "Nome do remetente"
    },
    "sender_key": {
      "type": "string",
      "description": "Chave do remetente"
    },
    "receiver_email": {
      "type": "string",
      "description": "Email do destinat\u00e1rio"
    },
    "receiver_name": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio"
    },
    "receiver_key": {
      "type": "string",
      "description": "Chave do destinat\u00e1rio utilizada"
    },
    "points_amount": {
      "type": "number",
      "description": "Quantidade de pontos transferida"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "under_review",
        "blocked",
        "cancelled"
      ],
      "default": "completed",
      "description": "Status da transfer\u00eancia"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low",
      "description": "N\u00edvel de risco detectado"
    },
    "risk_reason": {
      "type": "string",
      "description": "Motivo do alerta de risco (se houver)"
    },
    "sender_ip": {
      "type": "string",
      "description": "IP do remetente"
    },
    "sender_user_agent": {
      "type": "string",
      "description": "User-Agent do remetente"
    },
    "requires_2fa": {
      "type": "boolean",
      "default": false,
      "description": "Exigiu confirma\u00e7\u00e3o adicional por e-mail"
    },
    "processed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hor\u00e1rio de processamento"
    },
    "note": {
      "type": "string",
      "description": "Nota opcional"
    }
  },
  "required": [
    "transfer_id",
    "sender_email",
    "receiver_email",
    "points_amount",
    "status"
  ]
}