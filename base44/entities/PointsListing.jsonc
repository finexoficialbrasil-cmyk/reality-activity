{
  "name": "PointsListing",
  "type": "object",
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "properties": {
    "seller_email": {
      "type": "string",
      "description": "Email do vendedor"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "points_amount": {
      "type": "number",
      "description": "Quantidade de pontos ainda dispon\u00edvel no an\u00fancio (decrementada em vendas parciais)"
    },
    "original_points_amount": {
      "type": "number",
      "description": "Quantidade original total de pontos anunciada (antes de vendas parciais)"
    },
    "price_per_point": {
      "type": "number",
      "description": "Pre\u00e7o por ponto (R$)"
    },
    "total_price": {
      "type": "number",
      "description": "Valor restante da venda (R$) \u2014 atualizado ap\u00f3s cada venda parcial"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp do vendedor para contato (apenas d\u00edgitos com DDI/DDD)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "cancelled"
      ],
      "default": "active",
      "description": "Status do an\u00fancio"
    },
    "reserved": {
      "type": "boolean",
      "default": false,
      "description": "Indica se os pontos foram reservados (debitados) do vendedor na cria\u00e7\u00e3o do an\u00fancio"
    },
    "partial_sales_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de vendas parciais conclu\u00eddas neste an\u00fancio"
    },
    "buyer_id": {
      "type": "string",
      "description": "ID real do usu\u00e1rio comprador que manifestou interesse (vinculado ao listing)"
    },
    "buyer_email": {
      "type": "string",
      "description": "Email do comprador identificado"
    },
    "buyer_name": {
      "type": "string",
      "description": "Nome do comprador identificado"
    },
    "buyer_declared_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o comprador manifestou interesse"
    },
    "buyer_declared_quantity": {
      "type": "number",
      "description": "Quantidade de pontos que o comprador declarou querer comprar (venda parcial)"
    },
    "sold_at": {
      "type": "string",
      "format": "date-time"
    },
    "sale_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima confirma\u00e7\u00e3o de venda pelo vendedor"
    },
    "sale_request_id": {
      "type": "string",
      "description": "Identificador de idempot\u00eancia da \u00faltima confirma\u00e7\u00e3o de venda"
    }
  },
  "required": [
    "seller_email",
    "seller_name",
    "points_amount",
    "total_price",
    "whatsapp_number"
  ]
}