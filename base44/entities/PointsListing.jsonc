{
  "name": "PointsListing",
  "type": "object",
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "properties": {
    "seller_email": {
      "type": "string",
      "description": "Email do vendedor"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "points_amount": {
      "type": "number",
      "description": "Quantidade de pontos \u00e0 venda"
    },
    "price_per_point": {
      "type": "number",
      "description": "Pre\u00e7o por ponto (R$)"
    },
    "total_price": {
      "type": "number",
      "description": "Valor total da venda (R$)"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp do vendedor para contato (apenas d\u00edgitos com DDI/DDD)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "cancelled"
      ],
      "default": "active",
      "description": "Status do an\u00fancio"
    },
    "buyer_email": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "sold_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "seller_email",
    "seller_name",
    "points_amount",
    "total_price",
    "whatsapp_number"
  ]
}