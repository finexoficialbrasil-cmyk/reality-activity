{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "points_cost": {
      "type": "number",
      "description": "Pontos necess\u00e1rios para resgatar"
    },
    "original_price": {
      "type": "number",
      "description": "Pre\u00e7o original em R$"
    },
    "category": {
      "type": "string"
    },
    "stock": {
      "type": "number",
      "default": 999
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "redemptions_count": {
      "type": "number",
      "default": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "physical",
        "digital"
      ],
      "default": "physical",
      "description": "Tipo de produto: f\u00edsico ou digital"
    },
    "digital_content": {
      "type": "string",
      "description": "Link de download ou c\u00f3digo/arquivo para produtos digitais"
    }
  },
  "required": [
    "name",
    "company_id",
    "points_cost"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}