{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "slug": {
      "type": "string",
      "description": "Identificador \u00fanico URL-friendly"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Imagem de capa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da empresa"
    },
    "category": {
      "type": "string",
      "enum": [
        "Alimenta\u00e7\u00e3o",
        "Tecnologia",
        "Moda",
        "Sa\u00fade",
        "Educa\u00e7\u00e3o",
        "Entretenimento",
        "Servi\u00e7os",
        "Varejo",
        "Parceiro"
      ],
      "description": "Categoria"
    },
    "website": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "is_partner": {
      "type": "boolean",
      "default": false,
      "description": "\u00c9 parceiro externo?"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "points_accepted": {
      "type": "boolean",
      "default": true,
      "description": "Aceita pontos?"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}