{
  "name": "ProcessedRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Identificador \u00fanico da requisi\u00e7\u00e3o (idempot\u00eancia)"
    },
    "operation": {
      "type": "string",
      "description": "Tipo da opera\u00e7\u00e3o (share, withdrawal, transfer, etc.)"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que originou a requisi\u00e7\u00e3o"
    },
    "result": {
      "type": "object",
      "description": "Resposta armazenada para replay idempotente",
      "properties": {
        "body": {},
        "status": {
          "type": "number"
        }
      }
    },
    "result_status": {
      "type": "number",
      "description": "Status HTTP armazenado para replay"
    }
  },
  "required": [
    "request_id",
    "operation"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}