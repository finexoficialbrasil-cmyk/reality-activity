{
  "name": "PointsTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "earned_watch",
        "earned_bonus",
        "spent_redemption",
        "manual_adjust",
        "transfer_sent",
        "transfer_received",
        "marketplace_bought",
        "marketplace_sold",
        "marketplace_listed",
        "marketplace_listing_cancelled",
        "withdrawal_debit",
        "withdrawal_refund",
        "invalid_link_attempt"
      ],
      "description": "Tipo de transa\u00e7\u00e3o"
    },
    "points": {
      "type": "number",
      "description": "Pontos (positivo = ganhou, negativo = gastou)"
    },
    "balance_before": {
      "type": "number",
      "description": "Saldo do usu\u00e1rio imediatamente antes desta movimenta\u00e7\u00e3o"
    },
    "balance_after": {
      "type": "number",
      "description": "Saldo do usu\u00e1rio imediatamente depois desta movimenta\u00e7\u00e3o"
    },
    "request_id": {
      "type": "string",
      "description": "Identificador de idempot\u00eancia da requisi\u00e7\u00e3o que originou a transa\u00e7\u00e3o"
    },
    "origin": {
      "type": "string",
      "description": "Origem da opera\u00e7\u00e3o (ex: withdrawal, transfer, share, video, marketplace, purchase, admin_adjust)"
    },
    "destination": {
      "type": "string",
      "description": "Destino/contraparte da opera\u00e7\u00e3o (ex: email do destinat\u00e1rio, listing_id, product_id)"
    },
    "original_reference": {
      "type": "string",
      "description": "Refer\u00eancia da opera\u00e7\u00e3o original (ex: transfer_id, transaction_id, withdrawal_id)"
    },
    "video_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "watch_seconds": {
      "type": "number",
      "description": "Segundos assistidos nessa sess\u00e3o"
    },
    "transfer_email": {
      "type": "string",
      "description": "Email da contraparte na transfer\u00eancia"
    },
    "transfer_name": {
      "type": "string",
      "description": "Nome da contraparte"
    },
    "transaction_value": {
      "type": "number",
      "default": 0,
      "description": "Valor financeiro da transa\u00e7\u00e3o (R$)"
    },
    "listing_id": {
      "type": "string",
      "description": "ID do listing do marketplace"
    }
  },
  "required": [
    "user_email",
    "type",
    "points"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}