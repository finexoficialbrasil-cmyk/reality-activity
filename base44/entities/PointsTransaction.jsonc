{
  "name": "PointsTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "earned_watch",
        "earned_bonus",
        "spent_redemption",
        "manual_adjust",
        "transfer_sent",
        "transfer_received",
        "marketplace_bought",
        "marketplace_sold"
      ],
      "description": "Tipo de transa\u00e7\u00e3o"
    },
    "points": {
      "type": "number",
      "description": "Pontos (positivo = ganhou, negativo = gastou)"
    },
    "video_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "watch_seconds": {
      "type": "number",
      "description": "Segundos assistidos nessa sess\u00e3o"
    },
    "transfer_email": {
      "type": "string",
      "description": "Email da contraparte na transfer\u00eancia"
    },
    "transfer_name": {
      "type": "string",
      "description": "Nome da contraparte"
    },
    "transaction_value": {
      "type": "number",
      "default": 0,
      "description": "Valor financeiro da transa\u00e7\u00e3o (R$)"
    },
    "listing_id": {
      "type": "string",
      "description": "ID do listing do marketplace"
    }
  },
  "required": [
    "user_email",
    "type",
    "points"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}